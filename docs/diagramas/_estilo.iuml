!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 14
skinparam ArrowColor #0A7C86
skinparam ArrowThickness 1.4
skinparam ArrowFontColor #16313A
skinparam ArrowFontSize 11
skinparam TitleFontSize 20
skinparam TitleFontColor #16313A
skinparam RectangleBorderColor #0A7C86
skinparam RectangleBackgroundColor #E6F6FA
skinparam ActorBorderColor #0A7C86
skinparam ActorBackgroundColor #FFF4E2
skinparam UsecaseBorderColor #0A7C86
skinparam UsecaseBackgroundColor #FFF4E2
skinparam ComponentBorderColor #0A7C86
skinparam ComponentBackgroundColor #E6F6FA
skinparam PackageBorderColor #B87A1E
skinparam PackageBackgroundColor #FFFCF5
skinparam ClassBorderColor #0A7C86
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #D6F3F2
skinparam ClassAttributeFontSize 12
skinparam NoteBackgroundColor #FFF4E2
skinparam NoteBorderColor #B87A1E
skinparam SequenceLifeLineBorderColor #0A7C86
skinparam ParticipantBackgroundColor #E6F6FA
skinparam ParticipantBorderColor #0A7C86
skinparam DatabaseBackgroundColor #FFF4E2
skinparam DatabaseBorderColor #B87A1E
skinparam CloudBackgroundColor #E6F6FA
skinparam NodeBackgroundColor #FFFCF5
skinparam NodeBorderColor #B87A1E
