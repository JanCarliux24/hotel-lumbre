@startuml 01_contexto
!include _estilo.iuml
title Diagrama de contexto (DFD nivel 0) — Lumbre Hotel & Spa\n<size:12>Notación Yourdon/DeMarco · flujos numerados F1–F14 (ver tabla del documento)</size>
left to right direction
skinparam RectangleFontSize 13

rectangle "<b>E1</b>\nHuésped /\nvisitante" as H #FFF4E2
rectangle "<b>E2</b>\nRecepción\n(rol STAFF)" as R #FFF4E2
rectangle "<b>E3</b>\nAdministrador\n(rol ADMIN)" as A #FFF4E2
rectangle "<b>E4</b>\nSuperusuario\n(rol SUPERADMIN)" as S #FFF4E2

usecase "<b>0</b>\n<b>Sistema de reservas</b>\n<b>Lumbre Hotel & Spa</b>\napp Android · iOS · web\n+ base de datos Firebase" as SYS #D6F3F2

rectangle "<b>E5</b>\nFirebase\nAuthentication" as FA #E6F6FA
rectangle "<b>E6</b>\nServicio de\ngeolocalización\n(BigDataCloud)" as GEO #E6F6FA
rectangle "<b>E7</b>\nServicio de correo\nde Firebase" as MAIL #E6F6FA
rectangle "<b>E8</b>\nSistema operativo /\nnavegador\n(permiso de ubicación)" as OS #E6F6FA

H --> SYS : F1 datos de reserva\n(fechas, huéspedes, habitación,\nextras, código, contacto)
H --> SYS : F2 consentimiento de cookies,\ncredenciales, preferencias
SYS --> H : F3 presupuesto, referencia LMB-XXXXXX,\nmis reservas, llave digital, avisos
R --> SYS : F4 registro de llegada,\ncancelación
SYS --> R : F5 llegadas / en el hotel /\nsalidas del día
A --> SYS : F6 precios, disponibilidad,\npromociones
SYS --> A : F7 indicadores, ingresos,\nlistado filtrado
S --> SYS : F8 roles, bloqueo de cuentas,\nparámetros, mantenimiento
SYS --> S : F9 usuarios, auditoría,\nestado de seguridad
SYS --> FA : F10 alta, inicio de sesión,\nrenovación de token
FA --> SYS : F10' UID + idToken (1 h)\n+ refreshToken
SYS --> GEO : F11 lat/lon redondeadas (~11 km)
GEO --> SYS : F11' código de país ISO
FA --> MAIL : F12 solicitud de verificación\no restablecimiento
MAIL --> H : F13 correo con enlace
SYS --> OS : F14 solicitud de permiso\nde ubicación
OS --> SYS : F14' coordenadas o rechazo

note bottom of SYS
  <b>Límite del sistema</b>: interfaz de las 3 plataformas,
  reglas de negocio (presupuesto, validaciones, roles),
  sincronización y la base de datos Cloud Firestore
  (con sus reglas de seguridad) forman el proceso 0.
end note
@enduml
