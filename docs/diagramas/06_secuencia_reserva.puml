@startuml 06_secuencia_reserva
!include _estilo.iuml
title Secuencia: reservar con sesión iniciada
autonumber
actor Huésped as U
participant "BookingScreen" as UI
participant "Validation" as VAL
participant "Pricing" as PR
participant "HotelRepository" as REPO
participant "FirestoreApi" as FS
database "Cloud Firestore\n(reglas)" as DB

U -> UI : elige fechas, huéspedes, habitación y extras
UI -> VAL : dates(llegada, salida, hoy, parámetros)
VAL --> UI : válido / clave de error
UI -> PR : quote(habitación, fechas, extras, promo, parámetros)
PR --> UI : desglose y total
U -> UI : datos personales + consentimiento
UI -> VAL : name / email / phone
VAL --> UI : válido
U -> UI : Confirmar reserva
UI -> REPO : book(borrador)
REPO -> REPO : comprueba espera entre reservas\ngenera referencia LMB-XXXXXX
REPO --> UI : reserva confirmada (actualización optimista)
UI --> U : pantalla de éxito + confeti
REPO -> FS : set("reservations/{ref}", campos)
FS -> DB : PATCH con token de sesión
DB -> DB : regla: uid = auth.uid, estado CONFIRMED,\nrangos de adultos/niños, fechas coherentes
DB --> FS : 200 OK (o 403 si no cumple)
alt error de red o permiso
  FS --> REPO : excepción
  REPO --> UI : evento de error (snackbar) y resincronización
end
@enduml
